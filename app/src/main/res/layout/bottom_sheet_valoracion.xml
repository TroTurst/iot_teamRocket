<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="32dp"
    android:background="@drawable/bg_content_rounded">

    <!-- Ícono estrella -->
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_star_filled"
        android:contentDescription="Valoración"
        app:tint="#F5A623" />

    <!-- Título dinámico -->
    <TextView
        android:id="@+id/tvTituloValoracion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="¿Cómo calificas el proyecto?"
        android:textColor="#1A1A1A"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingMultiplier="1.2" />

    <!-- Subtítulo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Tu opinión ayuda a otros usuarios a elegir mejor"
        android:textColor="#888888"
        android:textSize="13sp" />

    <!-- Estrellas -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/star1"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_star_outline"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="1 estrella"
            app:tint="#F5A623" />

        <ImageView
            android:id="@+id/star2"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_star_outline"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="2 estrellas"
            app:tint="#F5A623" />

        <ImageView
            android:id="@+id/star3"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_star_outline"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="3 estrellas"
            app:tint="#F5A623" />

        <ImageView
            android:id="@+id/star4"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_star_outline"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="4 estrellas"
            app:tint="#F5A623" />

        <ImageView
            android:id="@+id/star5"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_star_outline"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="5 estrellas"
            app:tint="#F5A623" />

    </LinearLayout>

    <!-- Observaciones -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="#E0E0E0"
        app:boxBackgroundColor="#F5FAFA"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etObservaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cuéntanos tu experiencia (opcional)"
            android:minLines="3"
            android:maxLines="5"
            android:gravity="top|start"
            android:textSize="14sp"
            android:inputType="textMultiLine|textCapSentences" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botón enviar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnviarValoracion"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Enviar valoración"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        app:backgroundTint="#0A9098"
        app:cornerRadius="14dp" />

    <!-- Saltar -->
    <TextView
        android:id="@+id/tvSaltarValoracion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="Saltar por ahora"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>