<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#E0EEEE"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#F8FBFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvNombreTipologia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="65 m² · 2d"
            android:textColor="@color/inmia_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSpecsTipologia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="65 m² • 2d • 2b"
            android:textColor="#7A9E9E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPrecioTipologia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="S/ 648,000"
            android:textColor="@color/inmia_teal_dark"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

