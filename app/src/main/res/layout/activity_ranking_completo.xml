<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FAFA">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── HEADER — botón atrás + título, sin logo ── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_background"
                android:paddingTop="48dp"
                android:paddingBottom="24dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- Botón atrás -->
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Volver"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <!-- Título inline con botón atrás -->
                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ranking de inmobiliarias"
                    android:textColor="@color/inmia_text"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="8dp"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    app:layout_constraintBottom_toBottomOf="@id/btnBack"
                    app:layout_constraintStart_toEndOf="@id/btnBack"/>

                <!-- Filtros de período -->
                <HorizontalScrollView
                    android:id="@+id/scrollFiltros"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/btnBack"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tabHoy"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Hoy"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/sa_tab_periodo_selected"
                            android:textColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"/>

                        <TextView
                            android:id="@+id/tabSemana"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Semana"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/sa_tab_periodo_unselected"
                            android:textColor="@color/inmia_teal_dark"
                            android:clickable="true"
                            android:focusable="true"/>

                        <TextView
                            android:id="@+id/tabMes"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Mes"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/sa_tab_periodo_unselected"
                            android:textColor="@color/inmia_teal_dark"
                            android:clickable="true"
                            android:focusable="true"/>

                        <TextView
                            android:id="@+id/tabAnio"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Año"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/sa_tab_periodo_unselected"
                            android:textColor="@color/inmia_teal_dark"
                            android:clickable="true"
                            android:focusable="true"/>

                        <TextView
                            android:id="@+id/tabRango"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Rango"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:background="@drawable/sa_tab_periodo_unselected"
                            android:textColor="@color/inmia_teal_dark"
                            android:clickable="true"
                            android:focusable="true"/>

                    </LinearLayout>
                </HorizontalScrollView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ── CARD RANKING COMPLETO ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Separaciones realizadas"
                        android:textColor="@color/inmia_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Fila 1 — verde -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/sa_badge_ranking_1"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Catalina Sky"
                            android:textColor="@color/inmia_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="23"
                            android:textColor="@color/inmia_text"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <!-- Fila 2 — teal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="2"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/sa_badge_ranking_2"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Inmobiliaria Telito"
                            android:textColor="@color/inmia_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18"
                            android:textColor="@color/inmia_text"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <!-- Fila 3 — rojo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="3"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/sa_badge_ranking_3"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="BV Inmobi"
                            android:textColor="@color/inmia_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14"
                            android:textColor="@color/inmia_text"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <!-- Fila 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="4"
                            android:textColor="@color/inmia_text"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/sa_badge_ranking_normal"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CSKA"
                            android:textColor="@color/inmia_text"
                            android:textSize="14sp"
                            android:layout_marginStart="12dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10"
                            android:textColor="@color/inmia_text"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <!-- Fila 5 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="5"
                            android:textColor="@color/inmia_text"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/sa_badge_ranking_normal"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Portales"
                            android:textColor="@color/inmia_text"
                            android:textSize="14sp"
                            android:layout_marginStart="12dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7"
                            android:textColor="@color/inmia_text"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <!-- Fila 6 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="6"
                            android:textColor="@color/inmia_text"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/sa_badge_ranking_normal"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Java Products"
                            android:textColor="@color/inmia_text"
                            android:textSize="14sp"
                            android:layout_marginStart="12dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5"
                            android:textColor="@color/inmia_text"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <!-- Fila 7 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="7"
                            android:textColor="@color/inmia_text"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/sa_badge_ranking_normal"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Idea Inmobiliarias"
                            android:textColor="@color/inmia_text"
                            android:textSize="14sp"
                            android:layout_marginStart="12dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4"
                            android:textColor="@color/inmia_text"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <!-- Fila 8 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="8"
                            android:textColor="@color/inmia_text"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/sa_badge_ranking_normal"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tats"
                            android:textColor="@color/inmia_text"
                            android:textSize="14sp"
                            android:layout_marginStart="12dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2"
                            android:textColor="@color/inmia_text"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── BOTTOM NAVIGATION ── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavSuperAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        app:menu="@menu/menu_superadmin"
        app:itemIconTint="@color/inmia_teal_dark"
        app:itemTextColor="@color/inmia_teal_dark"
        app:labelVisibilityMode="labeled"
        app:elevation="12dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>