<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FAFA">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_background2"
                android:paddingTop="48dp"
                android:paddingBottom="48dp">

                <FrameLayout
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="Atrás"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detalle de Trámite"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="4dp"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    app:layout_constraintBottom_toBottomOf="@id/btnBack"
                    app:layout_constraintStart_toEndOf="@id/btnBack"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:background="@drawable/bg_content_rounded"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="40dp">

                <LinearLayout
                    android:id="@+id/bannerEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#E0F2F1"
                    android:padding="16dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvEstadoMensaje"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Estamos validando tu solicitud..."
                        android:textColor="#00695C"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAlignment="center"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/bannerEstado">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProyectoDetalle"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:scaleType="centerCrop"
                        android:background="#D0D0D0"
                        app:shapeAppearanceOverlay="@style/RoundedSquare" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvNombreProyectoDetalle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cargando..." android:textColor="#222222" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvTipologiaDetalle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="..." android:textColor="#888888" android:textSize="13sp" />
                        <TextView android:id="@+id/tvUbicacionDetalle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="..." android:textColor="#888888" android:textSize="13sp" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:id="@+id/divisor" android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginTop="20dp" app:layout_constraintTop_toBottomOf="@id/layoutSummary" />

                <LinearLayout
                    android:id="@+id/layoutPrecio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/divisor">

                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Monto a Pagar:" android:textColor="#555555" android:textSize="14sp" />
                    <TextView android:id="@+id/tvMontoDetalle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S/ 0.00" android:textColor="@color/inmia_teal_dark" android:textSize="18sp" android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProcederPago"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:text="Validando datos..."
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#9E9E9E"
                    app:cornerRadius="12dp"
                    app:layout_constraintTop_toBottomOf="@id/layoutPrecio" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelarSeparacion"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="Cancelar Trámite"
                    android:textAllCaps="false"
                    android:textColor="#FF4C4C"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    app:layout_constraintTop_toBottomOf="@id/btnProcederPago" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>