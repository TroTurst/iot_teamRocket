<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FAFA">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── HEADER ── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_background"
                android:paddingTop="48dp"
                android:paddingBottom="24dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- Logo -->
                <ImageView
                    android:id="@+id/imgHeaderLogo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_logo_inmia"
                    android:contentDescription="@string/cd_logo"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvHeaderAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/inmia_text"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.2"
                    android:layout_marginStart="8dp"
                    app:layout_constraintTop_toTopOf="@id/imgHeaderLogo"
                    app:layout_constraintBottom_toBottomOf="@id/imgHeaderLogo"
                    app:layout_constraintStart_toEndOf="@id/imgHeaderLogo"/>

                <!-- Título y subtítulo -->
                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Bienvenido!"
                    android:textColor="@color/inmia_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/imgHeaderLogo"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvSubtitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Registra los datos de tu inmobiliaria para comenzar"
                    android:textColor="#5A8A8A"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@id/tvTitulo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ── SECCIÓN 1: DATOS DE LA EMPRESA ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Datos de la empresa"
                        android:textColor="@color/inmia_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <!-- Nombre de la inmobiliaria -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNombreEmpresa"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:hint="Nombre de la inmobiliaria"
                        app:startIconDrawable="@drawable/ic_inicio"
                        app:startIconTint="@color/inmia_teal_dark"
                        app:boxStrokeColor="@color/inmia_teal_dark"
                        app:hintTextColor="@color/inmia_teal_dark"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNombreEmpresa"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:imeOptions="actionNext"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Correo de contacto -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCorreo"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:hint="Correo de contacto"
                        app:startIconDrawable="@android:drawable/ic_dialog_email"
                        app:startIconTint="@color/inmia_teal_dark"
                        app:boxStrokeColor="@color/inmia_teal_dark"
                        app:hintTextColor="@color/inmia_teal_dark"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCorreo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionNext"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Teléfono de contacto -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTelefono"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Teléfono de contacto"
                        app:startIconDrawable="@android:drawable/ic_menu_call"
                        app:startIconTint="@color/inmia_teal_dark"
                        app:boxStrokeColor="@color/inmia_teal_dark"
                        app:hintTextColor="@color/inmia_teal_dark"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTelefono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:imeOptions="actionNext"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── SECCIÓN 2: UBICACIÓN DE OFICINAS ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ubicación de oficinas"
                        android:textColor="@color/inmia_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <!-- Dirección de oficinas -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDireccion"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:hint="Dirección de oficinas"
                        app:startIconDrawable="@drawable/ic_inicio"
                        app:startIconTint="@color/inmia_teal_dark"
                        app:boxStrokeColor="@color/inmia_teal_dark"
                        app:hintTextColor="@color/inmia_teal_dark"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDireccion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress"
                            android:imeOptions="actionNext"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Distrito -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDistrito"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:hint="Distrito"
                        app:startIconDrawable="@drawable/ic_inicio"
                        app:startIconTint="@color/inmia_teal_dark"
                        app:boxStrokeColor="@color/inmia_teal_dark"
                        app:hintTextColor="@color/inmia_teal_dark"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDistrito"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:imeOptions="actionNext"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Referencia -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilReferencia"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Referencia (opcional)"
                        app:startIconDrawable="@drawable/ic_inicio"
                        app:startIconTint="@color/inmia_teal_dark"
                        app:boxStrokeColor="@color/inmia_teal_dark"
                        app:hintTextColor="@color/inmia_teal_dark"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etReferencia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"

                            android:imeOptions="actionDone"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <!-- Divisor -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Botón añadir más oficinas -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAgregarOficina"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="+ Añadir otra oficina"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textColor="@color/inmia_teal_dark"
                        app:strokeColor="@color/inmia_teal_dark"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/ic_input_add"
                        app:iconTint="@color/inmia_teal_dark"
                        app:iconGravity="start"/>
                    <!-- Contenedor dinámico de oficinas extra -->
                    <LinearLayout
                        android:id="@+id/layoutOficinasExtra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── SECCIÓN 3: FOTOS PROMOCIONALES ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Título + contador -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fotos promocionales"
                            android:textColor="@color/inmia_text"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvContadorFotos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/2 mínimo"
                            android:textColor="#F4845F"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agrega al menos 2 fotos de tu empresa"
                        android:textColor="#7A9E9E"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Grid 2x2 de fotos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <!-- Foto 1 -->
                        <FrameLayout
                            android:id="@+id/frameFoto1"
                            android:layout_width="0dp"
                            android:layout_height="110dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_foto_add_sistema">

                            <ImageView
                                android:id="@+id/imgFoto1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone"/>

                            <LinearLayout
                                android:id="@+id/layoutAdd1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="vertical"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@android:drawable/ic_input_add"
                                    android:contentDescription="Agregar foto"
                                    app:tint="@color/inmia_teal_dark"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Foto 1"
                                    android:textColor="@color/inmia_teal_dark"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="4dp"/>

                            </LinearLayout>

                        </FrameLayout>

                        <!-- Foto 2 -->
                        <FrameLayout
                            android:id="@+id/frameFoto2"
                            android:layout_width="0dp"
                            android:layout_height="110dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_foto_add_sistema">

                            <ImageView
                                android:id="@+id/imgFoto2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone"/>

                            <LinearLayout
                                android:id="@+id/layoutAdd2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="vertical"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@android:drawable/ic_input_add"
                                    android:contentDescription="Agregar foto"
                                    app:tint="@color/inmia_teal_dark"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Foto 2"
                                    android:textColor="@color/inmia_teal_dark"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="4dp"/>

                            </LinearLayout>

                        </FrameLayout>

                    </LinearLayout>

                    <!-- Fila extra: foto 3 y 4 opcionales -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Foto 3 opcional -->
                        <FrameLayout
                            android:id="@+id/frameFoto3"
                            android:layout_width="0dp"
                            android:layout_height="110dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_foto_add_sistema">

                            <ImageView
                                android:id="@+id/imgFoto3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone"/>

                            <LinearLayout
                                android:id="@+id/layoutAdd3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="vertical"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@android:drawable/ic_input_add"
                                    android:contentDescription="Agregar foto"
                                    app:tint="#A0BFBF"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Opcional"
                                    android:textColor="#A0BFBF"
                                    android:textSize="11sp"
                                    android:layout_marginTop="4dp"/>

                            </LinearLayout>

                        </FrameLayout>

                        <!-- Foto 4 opcional -->
                        <FrameLayout
                            android:id="@+id/frameFoto4"
                            android:layout_width="0dp"
                            android:layout_height="110dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_foto_add_sistema">

                            <ImageView
                                android:id="@+id/imgFoto4"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone"/>

                            <LinearLayout
                                android:id="@+id/layoutAdd4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="vertical"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@android:drawable/ic_input_add"
                                    android:contentDescription="Agregar foto"
                                    app:tint="#A0BFBF"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Opcional"
                                    android:textColor="#A0BFBF"
                                    android:textSize="11sp"
                                    android:layout_marginTop="4dp"/>

                            </LinearLayout>

                        </FrameLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── BOTÓN GUARDAR ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                android:text="Guardar y continuar"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@color/inmia_white"
                app:backgroundTint="@color/inmia_teal_dark"
                app:cornerRadius="14dp"
                app:elevation="4dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>