<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FAFA">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── HEADER — solo título, sin filtros ── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerReportes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_background2"
                android:paddingTop="45dp"
                android:paddingBottom="40dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Reporte de reservas"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ── CONTENIDO — esquinas redondeadas con overlap ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="-24dp"
                android:background="@drawable/bg_content_rounded"
                android:paddingTop="16dp">

                <!-- ── FILTROS — ahora en el área blanca ── -->
                <HorizontalScrollView
                    android:id="@+id/scrollFiltros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tabSemana"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Semana"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/sa_tab_periodo_selected"
                            android:textColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"/>

                        <TextView
                            android:id="@+id/tabMes"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Mes"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/sa_tab_periodo_unselected"
                            android:textColor="@color/inmia_teal_dark"
                            android:clickable="true"
                            android:focusable="true"/>

                        <TextView
                            android:id="@+id/tabAnio"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Año"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/sa_tab_periodo_unselected"
                            android:textColor="@color/inmia_teal_dark"
                            android:clickable="true"
                            android:focusable="true"/>

                        <TextView
                            android:id="@+id/tabRango"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Rango"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:background="@drawable/sa_tab_periodo_unselected"
                            android:textColor="@color/inmia_teal_dark"
                            android:clickable="true"
                            android:focusable="true"/>

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Divisor bajo los filtros -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/inmia_line"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"/>

                <!-- ── CARDS ESTADÍSTICAS ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/sa_card_stat_green"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvTotalSeparaciones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="19"
                            android:textColor="#FFFFFF"
                            android:textSize="36sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvSubtituloSeparaciones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Separaciones\nesta semana"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.2"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/sa_card_stat_teal"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvTotalCitas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25"
                            android:textColor="#FFFFFF"
                            android:textSize="36sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvSubtituloCitas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Citas\nesta semana"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.2"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- ── GRÁFICA REAL — MPAndroidChart ── -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Separaciones/citas por día"
                                android:textColor="@color/inmia_text"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/sa_badge_ranking_2"
                                android:layout_marginEnd="4dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sep."
                                android:textColor="#7A9E9E"
                                android:textSize="11sp"
                                android:layout_marginEnd="10dp"/>

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/sa_badge_ranking_normal"
                                android:layout_marginEnd="4dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Citas"
                                android:textColor="#7A9E9E"
                                android:textSize="11sp"/>

                        </LinearLayout>

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/lineChart"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── RANKING POR INMOBILIARIA ── -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ranking por inmobiliaria"
                                    android:textColor="@color/inmia_text"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Separaciones realizadas"
                                    android:textColor="#7A9E9E"
                                    android:textSize="12sp"
                                    android:layout_marginTop="2dp"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvVerTodo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ver todo ›"
                                android:textColor="@color/inmia_teal_dark"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutRankingContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="12dp"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── BOTTOM NAVIGATION ── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavSuperAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        app:menu="@menu/menu_superadmin"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:elevation="12dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>