<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FAFA">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_background2"
                android:paddingTop="48dp"
                android:paddingBottom="48dp"
                app:layout_constraintTop_toTopOf="parent">

                <FrameLayout
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="Atrás"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registrar Cita"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="4dp"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    app:layout_constraintBottom_toBottomOf="@id/btnBack"
                    app:layout_constraintStart_toEndOf="@id/btnBack"/>

                <TextView
                    android:id="@+id/tvSubGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agenda tu visita al proyecto"
                    android:textColor="#FFFFFF"
                    android:alpha="0.85"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintTop_toBottomOf="@id/tvGreeting"
                    app:layout_constraintStart_toStartOf="@id/tvGreeting"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:background="@drawable/bg_content_rounded"
                android:paddingHorizontal="24dp"
                android:paddingTop="32dp"
                android:paddingBottom="40dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proyecto seleccionado"
                        android:textColor="@color/inmia_teal_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_light_cyan"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="24dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgResumenProyecto"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:scaleType="centerCrop"
                            android:background="#D0D0D0"
                            android:src="@drawable/onboarding1"
                            app:shapeAppearanceOverlay="@style/RoundedSquare" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tvResumenNombreProyecto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cargando proyecto..." android:textColor="@color/inmia_teal_dark" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvResumenUbicacionProyecto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cargando ubicación..." android:textColor="#18C0C1" android:textSize="10sp" />
                            <TextView android:id="@+id/tvResumenTipologia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tipología: Cargando..." android:textColor="#087A82" android:textStyle="bold" android:textSize="10sp" android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnCambiarProyecto"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_tipologia_active"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:text="Cambiar"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecciona la fecha"
                        android:textColor="@color/inmia_teal_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecciona el día de tu visita"
                        android:textColor="@color/inmia_teal_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:clipToPadding="false"
                        android:layout_marginBottom="24dp">

                        <LinearLayout
                            android:id="@+id/containerFechas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingEnd="16dp"/>
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/tvFechaSeleccionada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aún no has seleccionado una fecha"
                        android:textColor="@color/inmia_teal_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="24dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecciona el horario disponible"
                        android:textColor="@color/inmia_teal_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubtituloHorarios"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Elige una hora para tu cita"
                        android:textColor="#18C0C1"
                        android:textSize="10sp"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/btnHora1"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_time_active"
                            android:gravity="center"
                            android:text="10:00 AM"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnHora2"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_time_inactive"
                            android:gravity="center"
                            android:text="11:00 AM"
                            android:textColor="#18C0C1"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnHora3"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_time_inactive"
                            android:gravity="center"
                            android:text="12:00 PM"
                            android:textColor="#18C0C1"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asesor asignado"
                        android:textColor="@color/inmia_teal_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_light_cyan"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="32dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardBackgroundColor="@color/inmia_teal_dark"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp">
                            <ImageView
                                android:id="@+id/imgFotoAsesor"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/foto_perfil" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tvNombreAsesor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cargando asesor..." android:textColor="@color/inmia_teal_dark" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Asesor Inmobiliario" android:textColor="#18C0C1" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfirmarCita"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Confirmar Cita"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/inmia_teal_dark"
                        app:cornerRadius="16dp" />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>