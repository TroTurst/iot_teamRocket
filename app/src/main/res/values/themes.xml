<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base de la app -->
    <style name="Theme.Inmia" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/inmia_teal_dark</item>
        <item name="colorPrimaryVariant">@color/inmia_teal_light</item>
        <item name="colorOnPrimary">@color/inmia_white</item>
        <item name="colorSecondary">@color/inmia_teal_medium</item>
        <item name="colorOnSecondary">@color/inmia_white</item>
        <item name="android:statusBarColor">@color/inmia_teal_dark</item>
    </style>

    <!-- Tema para el Splash (sin ActionBar) -->
    <style name="Theme.Inmia.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/inmia_teal_dark</item>
    </style>

    <style name="RoundedSquare" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="RoundedCircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ThemeOverlay.Inmia.DatePicker" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/inmia_teal_dark</item>
        <item name="colorOnPrimary">@color/inmia_white</item>
        <item name="colorSurface">@color/inmia_white</item>
        <item name="colorOnSurface">@color/inmia_text</item>
    </style>

    <style name="Theme.Inmia.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="colorSecondary">@color/inmia_teal_medium</item>
        <item name="colorOnSecondary">@color/inmia_white</item>
    </style>

</resources>